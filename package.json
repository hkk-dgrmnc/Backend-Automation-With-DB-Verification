{
  "name": "mys-backend-automation",
  "version": "1.0.0",
  "description": "TypeScript and Playwright Test API automation framework with PostgreSQL database verification support.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests",
    "test:generator": "node --test tools/api-test-generator/test/*.test.js",
    "generate:api-test": "node tools/api-test-generator/index.js",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
