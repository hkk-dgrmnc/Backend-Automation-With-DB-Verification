BASE_URL=https://dev-mys.ptt.gov.tr
REQUEST_TIMEOUT_MS=30000

# Logging is disabled by default.
# LOG_LEVEL options: silent, error, warn, info, debug
# Set LOG_PAYLOADS=true only when request/response bodies are safe to print.
# Set LOG_DB_QUERIES=true only when SQL text and parameters are safe to print.
LOG_LEVEL=silent
LOG_PAYLOADS=false
LOG_DB_QUERIES=false
LOG_MAX_BODY_LENGTH=4000

# API tests are disabled by default to prevent accidental calls to restricted environments.
TESTS_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_TOKEN_CACHE_TTL_MS=300000
AUTH_TOKEN_EXPIRY_SKEW_MS=30000

# PostgreSQL values are used only for API result database verification.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sample_database
DB_USER=sample_user
DB_PASSWORD=sample_password
DB_SSL=false
DB_POOL_MAX=10
